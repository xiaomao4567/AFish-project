page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding-bottom: 100rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
}

.header-left {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.logout-btn {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
}

.table-section {
  padding: 20rpx 30rpx;
}

.table-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.table-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.table-text {
  font-size: 32rpx;
  color: #333;
}

.table-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: #fff;
  margin: 0 30rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  position: relative;
  right: 60rpx;
  font-size: 32rpx;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.category-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.category-item.active {
  background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
}

.category-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 26rpx;
  color: #333;
}

.category-item.active .category-name {
  color: #fff;
}

.content-scroll {
  height: calc(100vh - 500rpx);
  padding: 0 20rpx;
}

.dish-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.dish-card {
  width: 47%;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.dish-image {
  width: 100%;
  height: 280rpx;
}

.dish-info {
  padding: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.dish-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b35;
}

.dish-flavor {
  font-size: 22rpx;
  color: #666;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.combo-list {
  padding: 0 10rpx;
}

.combo-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.combo-image {
  width: 240rpx;
  height: 200rpx;
}

.combo-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.combo-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.combo-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.combo-items {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.combo-item {
  font-size: 22rpx;
  color: #666;
  padding: 4rpx 12rpx;
  background: #fff3e8;
  border-radius: 8rpx;
}

.combo-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.combo-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

.combo-tag {
  font-size: 22rpx;
  color: #fff;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
  border-radius: 20rpx;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.cart-btn {
  position: fixed;
  bottom: 180rpx;
  right: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
  z-index: 100;
}

.cart-icon-wrap {
  position: relative;
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -16rpx;
  right: -20rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: #ff4757;
  border-radius: 18rpx;
}

.cart-text {
  font-size: 22rpx;
  color: #fff;
  margin-top: 4rpx;
}

.table-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.table-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
}

.table-item {
  width: 33.33%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.table-item text {
  font-size: 28rpx;
  color: #333;
  padding: 20rpx 40rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.table-item:active text {
  background: #ff6b35;
  color: #fff;
}
