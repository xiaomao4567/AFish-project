page {
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FF6B6B 0%, #4ECDC4 50%, #45B7D1 100%);
  background-size: 400% 400%;
  animation: gradientMove 15s ease infinite;
  position: relative;
  overflow: hidden;
}

@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.bg-decoration {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  overflow: hidden;
}

.wave {
  position: absolute;
  bottom: 0;
  width: 200%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.1);
  animation: waveMove 8s ease-in-out infinite;
}

.wave1 {
  left: 0;
  animation-delay: 0s;
}

.wave2 {
  left: -50%;
  animation-delay: -2s;
  opacity: 0.7;
}

.wave3 {
  left: -100%;
  animation-delay: -4s;
  opacity: 0.5;
}

@keyframes waveMove {
  0%, 100% { transform: translateX(0) translateY(0); }
  50% { transform: translateX(-25%) translateY(-20rpx); }
}

.login-content {
  position: relative;
  z-index: 10;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.brand-logo {
  margin-bottom: 30rpx;
}

.fish-icon {
  width: 160rpx;
  height: 160rpx;
  animation: fishFloat 3s ease-in-out infinite;
}

@keyframes fishFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(3deg); }
}

.brand-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 16rpx;
  text-shadow: 2px 2px 12px rgba(0, 0, 0, 0.2);
}

.brand-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  margin-bottom: 30rpx;
}

.brand-features {
  display: flex;
  gap: 30rpx;
  justify-content: center;
}

.feature-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border-radius: 30rpx;
}

.login-box {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  transition: all 0.3s;
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn.loading {
  opacity: 0.7;
}

.btn-icon {
  font-size: 44rpx;
}

.btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.guest-btn {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #FF6B6B;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-btn text {
  font-size: 30rpx;
  color: #FF6B6B;
}

.footer {
  margin-top: 60rpx;
  text-align: center;
}

.footer text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}