.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  width: 100%;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 40rpx;
  color: #fff;
}

.header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #fff;
}

.cart-scroll {
  height: calc(100vh - 280rpx);
}

.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.item-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.item-flavor {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.combo-detail {
  margin-top: 12rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  overflow: hidden;
}

.combo-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
}

.combo-detail-title {
  font-size: 24rpx;
  color: #666;
}

.combo-detail-arrow {
  font-size: 20rpx;
  color: #999;
}

.combo-items-list {
  padding: 0 16rpx 12rpx;
}

.combo-sub-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eee;
}

.combo-sub-item:last-child {
  border-bottom: none;
}

.sub-item-name {
  flex: 1;
  font-size: 24rpx;
  color: #333;
}

.sub-item-flavor {
  font-size: 22rpx;
  color: #999;
  margin: 0 12rpx;
}

.sub-item-quantity {
  font-size: 24rpx;
  color: #666;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.quantity-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qty-btn {
  width: 50rpx;
  height: 50rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
}

.qty-value {
  font-size: 28rpx;
  font-weight: 500;
  min-width: 40rpx;
  text-align: center;
}

.item-subtotal {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b6b;
  margin-left: 20rpx;
}

.delete-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.total-info {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.total-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.order-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
}