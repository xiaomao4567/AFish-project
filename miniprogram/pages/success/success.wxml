<view class="container">
  <view class="success-card">
    <view class="success-icon">✓</view>
    <text class="success-title">下单成功</text>
    <text class="success-desc">您的订单已提交，请耐心等待上菜</text>
  </view>

  <view class="order-card">
    <view class="order-item">
      <text class="item-label">订单号</text>
      <text class="item-value order-no">{{orderNo}}</text>
    </view>
    <view class="order-item">
      <text class="item-label">下单时间</text>
      <text class="item-value">{{createTime}}</text>
    </view>
    <view class="order-item">
      <text class="item-label">订单状态</text>
      <text class="item-value status paid">{{status}}</text>
    </view>
    <view class="order-item total-row">
      <text class="item-label">订单金额</text>
      <text class="item-value total">¥{{total.toFixed(2)}}</text>
    </view>
  </view>

  <view class="btn-group">
    <view class="btn-secondary" bindtap="goHome">
      <text>继续点餐</text>
    </view>
    <view class="btn-primary" bindtap="viewOrder">
      <text>查看订单</text>
    </view>
  </view>
</view>