<view class="container">
  <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">下单成功</text>
    <view class="header-right"></view>
  </view>

  <view class="content">
    <view class="success-card">
      <view class="success-icon-wrap">
        <text class="success-icon">✓</text>
      </view>
      <text class="success-title">下单成功</text>
      <text class="success-desc">您的订单已提交，请耐心等待上菜</text>
    </view>

    <view class="order-card">
      <view class="card-header">
        <view class="card-icon">
          <text class="card-icon-text">📋</text>
        </view>
        <text class="card-title">订单详情</text>
      </view>
      
      <view class="order-item">
        <text class="item-label">订单编号</text>
        <text class="item-value order-no">{{orderNo}}</text>
      </view>
      <view class="order-item">
        <text class="item-label">下单时间</text>
        <text class="item-value">{{createTime}}</text>
      </view>
      <view class="order-item">
        <text class="item-label">订单状态</text>
        <text class="item-value status paid">{{status}}</text>
      </view>
      
      <view class="total-row">
        <text class="total-label">订单金额</text>
        <view class="total-value">
          <text class="total-symbol">¥</text>
          <text>{{totalStr}}</text>
        </view>
      </view>
    </view>

    <view class="btn-group">
      <view class="btn-secondary" bindtap="goHome">
        <text>继续点餐</text>
      </view>
      <view class="btn-primary" bindtap="viewOrder">
        <text>查看订单</text>
      </view>
    </view>

    <view class="features">
      <view class="feature-item">
        <text class="feature-icon">⏱️</text>
        <text class="feature-text">快速上菜</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🍽️</text>
        <text class="feature-text">新鲜食材</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🎯</text>
        <text class="feature-text">精准配送</text>
      </view>
    </view>
  </view>
</view>