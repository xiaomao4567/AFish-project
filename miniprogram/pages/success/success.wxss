.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
}

.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  width: 100%;
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.header-right {
  width: 60rpx;
}

.content {
  padding: 40rpx 30rpx;
}

.success-card {
  background: linear-gradient(135deg, #fff 0%, #fafafa 100%);
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.success-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 50%, #81C784 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(76, 175, 80, 0.3);
}

.success-icon {
  font-size: 80rpx;
  color: #fff;
  font-weight: bold;
}

.success-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  letter-spacing: 4rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
  display: block;
  line-height: 1.6;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.card-icon-text {
  font-size: 28rpx;
  color: #fff;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.item-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.item-value {
  font-size: 28rpx;
  color: #333;
}

.order-no {
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
  font-size: 26rpx;
  color: #444;
}

.status {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status.paid {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  color: #2E7D32;
  border: 1rpx solid #A5D6A7;
}

.total-row {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFEBEE 100%);
  margin: 20rpx -40rpx -40rpx;
  padding: 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-label {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
}

.total-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF6B6B;
  display: flex;
  align-items: baseline;
}

.total-symbol {
  font-size: 36rpx;
  margin-right: 4rpx;
}

.btn-group {
  display: flex;
  gap: 24rpx;
}

.btn-secondary {
  flex: 1;
  background: #fff;
  color: #555;
  padding: 32rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  border: 2rpx solid #e0e0e0;
  transition: all 0.3s;
}

.btn-secondary:active {
  background: #f5f5f5;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #fff;
  padding: 32rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  transition: all 0.3s;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.features {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #666;
}