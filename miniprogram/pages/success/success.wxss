.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx;
}

.success-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4caf50 0%, #81c784 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: #fff;
  margin: 0 auto 30rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.success-desc {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.order-item.total-row {
  padding-top: 24rpx;
}

.item-label {
  font-size: 28rpx;
  color: #666;
}

.item-value {
  font-size: 28rpx;
  color: #333;
}

.order-no {
  font-family: monospace;
}

.status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status.paid {
  background: #e8f5e9;
  color: #4caf50;
}

.total {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.btn-group {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  padding: 28rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  padding: 28rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
}