.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.order-header {
  background: #fff;
  padding: 30rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.table-tag {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

.order-scroll {
  height: calc(100vh - 260rpx);
}

.order-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.item-flavor {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.item-price {
  font-size: 26rpx;
  color: #666;
}

.item-quantity {
  font-size: 26rpx;
  color: #999;
}

.item-subtotal {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b6b;
  margin-left: 20rpx;
}

.remark-input {
  width: 100%;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.total-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.submit-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  padding: 28rpx 80rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}