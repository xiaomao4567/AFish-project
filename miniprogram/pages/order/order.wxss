.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  width: 100%;
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.header-right {
  display: flex;
  align-items: center;
}

.table-tag {
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.order-scroll {
  height: calc(100vh - 280rpx);
}

.order-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.item-flavor {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.combo-detail {
  margin-top: 12rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  overflow: hidden;
}

.combo-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
}

.combo-detail-title {
  font-size: 24rpx;
  color: #666;
}

.combo-detail-arrow {
  font-size: 20rpx;
  color: #999;
}

.combo-items-list {
  padding: 0 16rpx 12rpx;
}

.combo-sub-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eee;
}

.combo-sub-item:last-child {
  border-bottom: none;
}

.sub-item-name {
  flex: 1;
  font-size: 24rpx;
  color: #333;
}

.sub-item-flavor {
  font-size: 22rpx;
  color: #999;
  margin: 0 12rpx;
}

.sub-item-quantity {
  font-size: 24rpx;
  color: #666;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.item-price {
  font-size: 26rpx;
  color: #666;
}

.item-quantity {
  font-size: 26rpx;
  color: #999;
}

.item-subtotal {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b6b;
  margin-left: 20rpx;
}

.remark-input {
  width: 100%;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.total-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.submit-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  padding: 28rpx 80rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}