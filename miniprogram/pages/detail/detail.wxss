.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.content-scroll {
  height: calc(100vh - 160rpx);
}

.detail-image {
  width: 100%;
  height: 500rpx;
}

.detail-info {
  background: #fff;
  margin-top: -40rpx;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx 30rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.detail-tag {
  background: linear-gradient(135deg, #ffc107 0%, #ffeb3b 100%);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.detail-price {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
}

.price-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.detail-desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.flavor-section, .items-section, .quantity-section {
  margin-top: 30rpx;
}

.flavor-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.flavor-item {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.flavor-item.active {
  background: #fff0f0;
  border-color: #ff6b6b;
  color: #ff6b6b;
}

.items-list {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 20rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.item-name {
  color: #333;
}

.item-quantity {
  color: #999;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.qty-btn {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
}

.qty-btn:active {
  background: #eee;
}

.qty-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  min-width: 60rpx;
  text-align: center;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.table-info {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.add-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}