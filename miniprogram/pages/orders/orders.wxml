<view class="container">
  <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">我的订单</text>
    <view class="header-right">
      <text class="table-tag" wx:if="{{tableNo}}">🪑 {{tableNo}}号桌</text>
    </view>
  </view>

  <view class="status-tabs">
    <view 
      wx:for="{{statusTabs}}" 
      wx:key="value"
      class="status-tab {{currentStatus === item.value ? 'active' : ''}}"
      bindtap="switchStatus"
      data-status="{{item.value}}"
    >
      <text class="tab-text">{{item.label}}</text>
      <view class="tab-badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
    </view>
  </view>

  <view class="empty-order" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <text class="empty-hint" wx:if="{{!tableNo}}">请先选择桌号</text>
    <view class="empty-btn" wx:if="{{!tableNo}}" bindtap="showTableModal">
      <text>选择桌号</text>
    </view>
  </view>

  <scroll-view 
    class="order-scroll" 
    scroll-y 
    wx:if="{{orders.length > 0}}"
    bindrefresherrefresh="refreshOrders"
    refresher-enabled="true"
  >
    <view class="order-list">
      <view 
        wx:for="{{orders}}" 
        wx:key="orderNo" 
        class="order-card"
        bindtap="viewDetail"
        data-order-no="{{item.orderNo}}"
      >
        <view class="order-header">
          <text class="order-no">订单号：{{item.orderNo}}</text>
          <text class="order-status {{item.status === 'PAID' ? 'paid' : item.status === 'PREPARING' ? 'preparing' : item.status === 'SERVED' ? 'served' : item.status === 'CANCELLED' ? 'cancelled' : 'pending'}}">
            {{item.status === 'PAID' ? '已支付' : item.status === 'PREPARING' ? '制作中' : item.status === 'SERVED' ? '已上菜' : item.status === 'CANCELLED' ? '已取消' : '待支付'}}
          </text>
        </view>
        
        <view class="order-items">
          <view wx:for="{{item.items}}" wx:for-item="subItem" wx:key="dishId" class="order-item">
            <image class="item-image" src="{{subItem.image}}" mode="aspectFill" />
            <view class="item-info">
              <text class="item-name">{{subItem.dishName || subItem.name}}</text>
              <text class="item-flavor" wx:if="{{subItem.flavor || subItem.taste}}">{{subItem.flavor || subItem.taste}}</text>
            </view>
            <text class="item-quantity">×{{subItem.quantity}}</text>
          </view>
          <text class="more-items" wx:if="{{item.items && item.items.length > 5}}">...等{{item.items.length}}件商品</text>
        </view>

        <view class="order-footer">
          <view class="order-info">
            <text class="order-time">{{item.createTime}}</text>
            <text class="order-total">¥{{item.totalAmount}}</text>
          </view>
          <view class="order-actions">
            <view 
              class="action-btn cancel" 
              wx:if="{{item.status === 'PAID' || item.status === 'PREPARING'}}" 
              bindtap="cancelOrder"
              data-order-no="{{item.orderNo}}"
            >
              <text>取消订单</text>
            </view>
            <view class="action-btn done" wx:if="{{item.status === 'SERVED' || item.status === 'CANCELLED'}}">
              <text wx:if="{{item.status === 'SERVED'}}">已完成</text>
              <text wx:if="{{item.status === 'CANCELLED'}}">已取消</text>
            </view>
            <view class="action-btn preparing" wx:if="{{item.status === 'PREPARING'}}">
              <text>制作中</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="table-modal" wx:if="{{showTableModal}}" bindtap="hideTableModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">选择桌号</text>
        <view class="modal-close" bindtap="hideTableModal">×</view>
      </view>
      <view class="table-grid">
        <view 
          wx:for="{{tableList}}" 
          wx:key="item" 
          class="table-item"
          bindtap="selectTable"
          data-table="{{item}}"
        >
          <text>{{item}}号桌</text>
        </view>
      </view>
    </view>
  </view>

  <view class="order-detail-modal" wx:if="{{showDetailModal}}" bindtap="hideDetailModal">
    <view class="detail-content" catchtap="stopPropagation">
      <view class="detail-header">
        <text class="detail-title">订单详情</text>
        <view class="detail-close" bindtap="hideDetailModal">×</view>
      </view>
      <view class="detail-body" wx:if="{{currentOrder}}">
        <view class="detail-row">
          <text class="detail-label">订单号</text>
          <text class="detail-value">{{currentOrder.orderNo}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">桌号</text>
          <text class="detail-value">🪑 {{currentOrder.tableNo}}号桌</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">下单时间</text>
          <text class="detail-value">{{currentOrder.createTime}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">订单状态</text>
          <text class="detail-value status {{currentOrder.status === 'PAID' ? 'paid' : currentOrder.status === 'PREPARING' ? 'preparing' : currentOrder.status === 'SERVED' ? 'served' : currentOrder.status === 'CANCELLED' ? 'cancelled' : 'pending'}}">
            {{currentOrder.status === 'PAID' ? '已支付' : currentOrder.status === 'PREPARING' ? '制作中' : currentOrder.status === 'SERVED' ? '已上菜' : currentOrder.status === 'CANCELLED' ? '已取消' : '待支付'}}
          </text>
        </view>
        <view class="detail-row" wx:if="{{currentOrder.remark}}">
          <text class="detail-label">备注</text>
          <text class="detail-value">{{currentOrder.remark}}</text>
        </view>
        <view class="detail-section">
          <text class="section-title">订单明细</text>
          <view class="detail-items">
            <view wx:for="{{currentOrder.items}}" wx:for-item="item" wx:key="dishId" class="detail-item">
              <image class="detail-item-image" src="{{item.image}}" mode="aspectFill" />
              <view class="detail-item-info">
                <text class="detail-item-name">{{item.dishName || item.name}}</text>
                <text class="detail-item-flavor">{{item.flavor || item.taste || '原味'}}</text>
              </view>
              <view class="detail-item-right">
                <text class="detail-item-price">¥{{item.price}}</text>
                <text class="detail-item-quantity">×{{item.quantity}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="detail-total">
          <text class="total-label">合计</text>
          <text class="total-value">¥{{currentOrder.totalAmount}}</text>
        </view>
      </view>
      <view class="detail-footer">
        <view 
          class="footer-btn cancel" 
          wx:if="{{currentOrder && (currentOrder.status === 'PAID' || currentOrder.status === 'PREPARING')}}" 
          bindtap="cancelOrder"
          data-order-no="{{currentOrder.orderNo}}"
        >
          <text>取消订单</text>
        </view>
        <view class="footer-btn close" wx:else bindtap="hideDetailModal">
          <text>关闭</text>
        </view>
      </view>
    </view>
  </view>
</view>