.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  width: 100%;
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.header-right {
  width: auto;
}

.table-tag {
  font-size: 26rpx;
  color: #fff;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
}

.status-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 10rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 1rpx solid #f5f5f5;
}

.status-tab {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  margin: 0 8rpx;
  background: #f8f8f8;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.status-tab.active {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
}

.tab-text {
  font-size: 26rpx;
  color: #666;
}

.status-tab.active .tab-text {
  color: #fff;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #FF4757;
  border-radius: 16rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
}

.status-tab.active .tab-badge {
  background: rgba(255, 255, 255, 0.3);
}

.empty-order {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 40rpx;
}

.empty-btn text {
  font-size: 28rpx;
  color: #fff;
}

.order-scroll {
  height: calc(100vh - 260rpx);
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 26rpx;
  color: #666;
  font-family: monospace;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.order-status.pending {
  background: #fff3e0;
  color: #ff9800;
}

.order-status.paid {
  background: #e8f5e9;
  color: #4caf50;
}

.order-status.preparing {
  background: #e3f2fd;
  color: #2196f3;
}

.order-status.served {
  background: #f3e5f5;
  color: #9c27b0;
}

.order-status.completed {
  background: #f5f5f5;
  color: #999;
}

.order-status.cancelled {
  background: #ffebee;
  color: #f44336;
}

.order-items {
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.order-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  padding: 12rpx 0;
}

.item-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-flavor {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-quantity {
  font-size: 26rpx;
  color: #666;
}

.more-items {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-info {
  display: flex;
  flex-direction: column;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-total {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b6b;
  margin-top: 4rpx;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.action-btn text {
  font-size: 26rpx;
}

.action-btn.cancel {
  border: 1rpx solid #999;
}

.action-btn.cancel text {
  color: #666;
}

.action-btn.pay {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
}

.action-btn.pay text {
  color: #fff;
}

.action-btn.done {
  background: #f5f5f5;
}

.action-btn.done text {
  color: #999;
}

.action-btn.preparing {
  background: linear-gradient(135deg, #FFE66D 0%, #FFA94D 100%);
}

.action-btn.preparing text {
  color: #fff;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.table-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.table-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
}

.table-item {
  width: 33.33%;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.table-item text {
  font-size: 28rpx;
  color: #333;
  padding: 20rpx 40rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.order-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.detail-content {
  width: 100%;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.detail-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.detail-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.detail-label {
  font-size: 28rpx;
  color: #999;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
}

.detail-value.status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.detail-value.status.paid {
  background: #e8f5e9;
  color: #4caf50;
}

.detail-value.status.preparing {
  background: #e3f2fd;
  color: #2196f3;
}

.detail-value.status.served {
  background: #f3e5f5;
  color: #9c27b0;
}

.detail-value.status.cancelled {
  background: #ffebee;
  color: #f44336;
}

.detail-value.status.pending {
  background: #fff3e0;
  color: #ff9800;
}

.detail-section {
  margin-top: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-items {
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 16rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-item-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.detail-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.detail-item-name {
  font-size: 28rpx;
  color: #333;
}

.detail-item-flavor {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.detail-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.detail-item-price {
  font-size: 28rpx;
  color: #333;
}

.detail-item-quantity {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.detail-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx dashed #eee;
  margin-top: 20rpx;
}

.total-label {
  font-size: 30rpx;
  color: #333;
}

.total-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.detail-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
}

.footer-btn text {
  font-size: 30rpx;
}

.footer-btn.cancel {
  border: 1rpx solid #999;
}

.footer-btn.cancel text {
  color: #666;
}

.footer-btn.pay {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
}

.footer-btn.pay text {
  color: #fff;
}

.footer-btn.close {
  background: #f5f5f5;
}

.footer-btn.close text {
  color: #666;
}