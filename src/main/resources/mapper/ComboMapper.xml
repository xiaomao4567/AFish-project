<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.yitiaoyu.server.mapper.ComboMapper">

    <resultMap id="ComboResultMap" type="com.example.yitiaoyu.pojo.entity.Combo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="image" property="image"/>
        <result column="price" property="price"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" parameterType="Long" resultMap="ComboResultMap">
        SELECT * FROM combo WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.example.yitiaoyu.pojo.entity.Combo" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO combo (name, description, image, price, status, create_time, update_time) 
        VALUES (#{name}, #{description}, #{image}, #{price}, #{status}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateById" parameterType="com.example.yitiaoyu.pojo.entity.Combo">
        UPDATE combo 
        SET name = #{name}, description = #{description}, image = #{image}, 
            price = #{price}, status = #{status}, update_time = #{updateTime} 
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM combo WHERE id = #{id}
    </delete>

    <select id="selectAll" resultMap="ComboResultMap">
        SELECT * FROM combo ORDER BY id ASC
    </select>

    <select id="selectByName" parameterType="String" resultMap="ComboResultMap">
        SELECT * FROM combo WHERE name = #{name}
    </select>

    <select id="selectByNameNotId" resultMap="ComboResultMap">
        SELECT * FROM combo WHERE name = #{name} AND id != #{id}
    </select>

    <select id="selectEnabled" resultMap="ComboResultMap">
        SELECT * FROM combo WHERE status = 1 ORDER BY id ASC
    </select>

</mapper>
